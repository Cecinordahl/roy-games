# Firebase project config — see README.md "Firebase project setup" for where to find these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to connect to the local Firebase emulators instead of the real project.
# Used automatically by `npm run dev` when the emulators are running; see README.
VITE_USE_FIREBASE_EMULATORS=false
